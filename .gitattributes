* text=auto

# Consistência de fim de linha por tipo de arquivo.
*.kt        text eol=lf
*.kts       text eol=lf
*.java      text eol=lf
*.gradle    text eol=lf
*.gradle.kts text eol=lf
*.xml       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.py        text eol=lf
*.sh        text eol=lf
*.bat       text eol=crlf

# Arquivos binários que não devem ter diffs por linha.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.keystore  binary
*.jks       binary
*.aab       binary
*.apk       binary
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      POST_NOTIFICATIONS (E3.6): exigida no Android 13+ (API 33) para
      publicar os lembretes de prazo. O pedido runtime acontece em
      MainActivity, na primeira entrada na Home; negativa é registrada
      em SessionStore para não insistir.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Remove também declarações transitivas de bibliotecas no manifesto final. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!--
      Backup automático do Android (issue #175 — DEF-37) DESLIGADO.

      O backup do Google levaria junto o `brainout.db` (com o hash das
      senhas) e o `auth_prefs.preferences_pb` (com o id do usuário
      logado) — a senha de cada conta foi derivada com o pepper do
      Android Keystore, então o hash não funciona em outro aparelho, e
      a sessão nem deveria sair do dispositivo.

      A transferência de dados é feita pelo backup manual, cifrado e
      sob controle do usuário (issue #214 — `docs/BACKUP.md`).
      `dataExtractionRules` cobre o Android 12+ (nuvem e transferência
      entre aparelhos) e `fullBackupContent="false"` cobre as versões
      anteriores.
    -->


    <application
        android:name=".BrainOutApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BrainOut"
        android:usesCleartextTraffic="false"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.BrainOut">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Receiver da notificação de prazo (E3.6). Não exportado: só o
          app dispara os intents de ação (Concluir / Dispensar).
        -->
        <receiver
            android:name=".notifications.DeadlineReceiver"
            android:enabled="true"
            android:exported="false" />

        <!--
          Hilt + WorkManager: desabilita o inicializador default para
          que a configuração venha de BrainOutApplication (E3.3/E3.6,
          workers com injeção via construtor).
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>

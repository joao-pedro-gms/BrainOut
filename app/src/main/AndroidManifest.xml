<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      POST_NOTIFICATIONS (E3.6): exigida no Android 13+ (API 33) para
      publicar os lembretes de prazo. O pedido runtime acontece em
      MainActivity, na primeira entrada na Home; negativa é registrada
      em SessionStore para não insistir.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      INTERNET + ACCESS_NETWORK_STATE (E3.2/E3.3/E3.4): chamadas HTTP ao
      backend-stub (Retrofit/OkHttp) e observação de conectividade
      (banner offline + reconciliação E3.4 + constraints do WorkManager).
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".BrainOutApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BrainOut"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">
        <!--
          usesCleartextTraffic (E3.2): o flavor dev aponta para o
          backend-stub em http://10.0.2.2:8000/ (HTTP puro no emulador).
          Sem esta flag, o OkHttp recebe "Cleartext HTTP traffic not
          permitted" no Android 9+. Prod usa https (placeholder TBD).
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.BrainOut">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Receiver da notificação de prazo (E3.6). Não exportado: só o
          app dispara os intents de ação (Concluir / Dispensar).
        -->
        <receiver
            android:name=".notifications.DeadlineReceiver"
            android:enabled="true"
            android:exported="false" />

        <!--
          Hilt + WorkManager: desabilita o inicializador default para
          que a configuração venha de BrainOutApplication (E3.3/E3.6,
          workers com injeção via construtor).
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
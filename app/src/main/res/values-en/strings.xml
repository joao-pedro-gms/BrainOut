<resources>
    <string name="app_name">BrainOut</string>

    <!--
      Deadline reminders / local notifications (E3.6).

      The `:app` module owns the notification code, so it owns these
      strings.

      Screen strings (splash, login, register, home, project detail,
      settings) do NOT live here: each module keeps its own, and
      `:app` keeps no copy of any. With `nonTransitiveRClass`, a key
      repeated in the app and in a feature is a dual source of truth —
      and the text edited in the feature would change nothing, because
      the resource merge makes the app's copy win.
    -->
    <string name="deadline_channel_name">Deadline reminders</string>
    <string name="deadline_channel_description">Notifications sent 1 hour before each task\'s deadline.</string>
    <string name="deadline_notification_title">Due: %1$s</string>
    <string name="deadline_notification_body">Project %1$s — due in 1 hour</string>
    <string name="deadline_action_complete">Complete</string>
    <string name="deadline_unknown_project">(no project)</string>
    <string name="deadline_permission_denied_toast">Notifications permission denied — deadline reminders won\'t be shown.</string>
</resources>

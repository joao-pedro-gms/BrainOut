<resources>
    <string name="app_name">BrainOut</string>

    <!--
      Lembretes de prazo / notificações locais (E3.6).

      O `:app` é o dono do código das notificações, então é ele que
      guarda as strings delas.

      As strings de tela (splash, login, register, home, project
      detail, settings) NÃO moram aqui: cada módulo guarda as suas,
      e `:app` não guarda cópia de nenhuma. Com `nonTransitiveRClass`,
      uma chave repetida no app e na feature é fonte de verdade dupla
      — e o texto editado na feature não mudaria nada, porque o merge
      de recursos faz a cópia do app prevalecer.
    -->
    <string name="deadline_channel_name">Lembretes de prazo</string>
    <string name="deadline_channel_description">Notificações enviadas 1 hora antes do prazo de cada tarefa.</string>
    <string name="deadline_notification_title">Prazo: %1$s</string>
    <string name="deadline_notification_body">Projeto %1$s — prazo em 1 hora</string>
    <string name="deadline_action_complete">Concluir</string>
    <string name="deadline_unknown_project">(sem projeto)</string>
    <string name="deadline_permission_denied_toast">Sem permissão de notificações — os lembretes de prazo não serão exibidos.</string>
    <string name="account_migration_title">Novos nomes de usuário</string>
    <string name="account_migration_message">As contas deste aparelho agora usam os nomes abaixo para entrar. As senhas e os dados foram preservados.</string>
    <string name="account_migration_ack">Entendi</string>
</resources>

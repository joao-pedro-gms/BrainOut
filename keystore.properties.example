# keystore.properties — exemplo.
# Copie para `keystore.properties` e preencha com dados reais.
# NUNCA versione este arquivo (coberto pelo .gitignore).
#
# Para builds de release via GitHub Actions, os valores devem ser
# fornecidos via Secrets (ver docs/CI-CD.md).

storeFile=secrets/release.keystore
storePassword=
keyAlias=
keyPassword=